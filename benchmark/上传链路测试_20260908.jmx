<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="上传链路测试">
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="20并发上传测试">
        <intProp name="ThreadGroup.num_threads">20</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <longProp name="ThreadGroup.duration">120</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="循环控制器">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="用户定义的变量" enabled="true">
          <collectionProp name="Arguments.arguments">
            <elementProp name="video_file_path" elementType="Argument">
              <stringProp name="Argument.name">video_file_path</stringProp>
              <stringProp name="Argument.value">S:\videonest\benchmark\666.mp4</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
            </elementProp>
            <elementProp name="upload_host" elementType="Argument">
              <stringProp name="Argument.name">upload_host</stringProp>
              <stringProp name="Argument.value">82.157.205.6</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
            </elementProp>
            <elementProp name="upload_path" elementType="Argument">
              <stringProp name="Argument.name">upload_path</stringProp>
              <stringProp name="Argument.value">/</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
            </elementProp>
            <elementProp name="upload_proto" elementType="Argument">
              <stringProp name="Argument.name">upload_proto</stringProp>
              <stringProp name="Argument.value">http</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
            </elementProp>
            <elementProp name="upload_port" elementType="Argument">
              <stringProp name="Argument.name">upload_port</stringProp>
              <stringProp name="Argument.value">9000</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
            </elementProp>
            <elementProp name="upload_id" elementType="Argument">
              <stringProp name="Argument.name">upload_id</stringProp>
              <stringProp name="Argument.value">default_upload_id</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
            </elementProp>
          </collectionProp>
        </Arguments>
        <hashTree/>
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="仅一次控制器" enabled="true"/>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="登录" enabled="true">
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
            <stringProp name="HTTPSampler.path">/api/auth/login</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;username&quot;:&quot;test_login_001&quot;,&quot;password&quot;:&quot;123456&quot;}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="JSON提取器-token" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">token</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.data.token</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP信息头管理器-登录" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
          </hashTree>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="预签名控制接口" enabled="true">
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/api/files/presign</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;type&quot;:&quot;video&quot;,&quot;fileName&quot;:&quot;666.mp4&quot;,&quot;contentType&quot;:&quot;video/mp4&quot;,&quot;size&quot;:${video_file_size}}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223-读取文件大小" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def file = new File(vars.get(&quot;video_file_path&quot;))
if (!file.isFile()) {
    throw new FileNotFoundException(&quot;测试文件不存在: &quot; + file.absolutePath)
}
vars.put(&quot;video_file_size&quot;, file.length().toString())
log.info(&quot;上传文件: &quot; + file.absolutePath + &quot;, size=&quot; + file.length())</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP信息头管理器-预签名" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${token}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223-提取预签名结果" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

def response = prev.getResponseDataAsString()
log.info(&quot;=====预签名响应开始=====&quot;)
log.info(response)
log.info(&quot;=====预签名响应结束=====&quot;)

try {
    def json = new JsonSlurper().parseText(response)
    def data = json.data

    if (data != null) {
        // 尝试多种可能的字段名提取上传URL
        def uploadUrl = null
        if (data.uploadUrl != null) uploadUrl = data.uploadUrl
        else if (data.url != null) uploadUrl = data.url
        else if (data.upload_url != null) uploadUrl = data.upload_url
        else if (data.presignedUrl != null) uploadUrl = data.presignedUrl
        else if (data.presigned_url != null) uploadUrl = data.presigned_url
        else if (data.uploadUrlList != null &amp;&amp; data.uploadUrlList.size() &gt; 0) uploadUrl = data.uploadUrlList[0]

        // 提取uploadId
        def uploadId = null
        if (data.uploadId != null) uploadId = data.uploadId
        else if (data.upload_id != null) uploadId = data.upload_id

        if (uploadUrl != null) {
            vars.put(&quot;upload_url&quot;, uploadUrl.toString())
            log.info(&quot;提取到upload_url: &quot; + uploadUrl)
        } else {
            log.error(&quot;未能提取到upload_url，data字段内容: &quot; + data.toString())
        }

        if (uploadId != null) {
            vars.put(&quot;upload_id&quot;, uploadId.toString())
            log.info(&quot;提取到upload_id: &quot; + uploadId)
        } else {
            log.error(&quot;未能提取到upload_id，data字段内容: &quot; + data.toString())
        }

        def headers = data.headers
        def contentType = headers instanceof Map ? headers[&quot;Content-Type&quot;] : null
        if (contentType != null) {
            vars.put(&quot;upload_content_type&quot;, contentType.toString())
            log.info(&quot;提取到上传请求头 Content-Type: &quot; + contentType)
        } else {
            log.error(&quot;预签名响应缺少 headers.Content-Type&quot;)
        }
    } else {
        log.error(&quot;响应中没有data字段&quot;)
    }
} catch (Exception e) {
    log.error(&quot;解析预签名响应异常: &quot; + e.getMessage(), e)
}
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="上传视频文件" enabled="true">
          <stringProp name="HTTPSampler.domain">${upload_host}</stringProp>
          <stringProp name="HTTPSampler.port">${upload_port}</stringProp>
          <stringProp name="HTTPSampler.protocol">${upload_proto}</stringProp>
          <stringProp name="HTTPSampler.path">${upload_path}</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">PUT</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <elementProp name="HTTPsampler.Files" elementType="HTTPFileArgs">
            <collectionProp name="HTTPFileArgs.files">
              <elementProp name="${video_file_path}" elementType="HTTPFileArg">
                <stringProp name="File.mimetype">video/mp4</stringProp>
                <stringProp name="File.path">${video_file_path}</stringProp>
                <stringProp name="File.paramname"></stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223-解析上传URL" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def fullUrl = vars.get(&quot;upload_url&quot;)
log.info(&quot;开始解析上传URL, upload_url=&quot; + fullUrl)

if (fullUrl != null &amp;&amp; fullUrl.startsWith(&quot;http&quot;)) {
    try {
        def parsedUrl = new URL(fullUrl)
        vars.put(&quot;upload_host&quot;, parsedUrl.getHost())
        vars.put(&quot;upload_path&quot;, parsedUrl.getFile())
        vars.put(&quot;upload_proto&quot;, parsedUrl.getProtocol())
        def port = parsedUrl.getPort()
        if (port == -1) {
            if (&quot;https&quot;.equals(parsedUrl.getProtocol())) {
                port = 443
            } else {
                port = 80
            }
        }
        vars.put(&quot;upload_port&quot;, port.toString())
        log.info(&quot;解析成功: host=&quot; + parsedUrl.getHost() + &quot;, port=&quot; + port + &quot;, path=&quot; + parsedUrl.getFile())
    } catch (Exception e) {
        log.error(&quot;URL解析异常: &quot; + e.getMessage())
    }
} else {
    log.warn(&quot;upload_url无效，使用默认值&quot;)
}
</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP信息头管理器-上传" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">${upload_content_type}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="上传完成确认" enabled="true">
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/api/files/uploads/${upload_id}/complete</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
