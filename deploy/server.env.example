# VideoNest 服务器部署配置示例
# 复制为项目根目录的 .env 后替换所有 CHANGE_ME，再执行 scripts/deploy.ps1。

DB_NAME=videonest
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
DB_POOL_MAX_SIZE=16
DB_POOL_MIN_IDLE=8

REDIS_USERNAME=default
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_POOL_MAX_ACTIVE=16
REDIS_POOL_MAX_IDLE=16
REDIS_POOL_MIN_IDLE=4

RABBITMQ_USERNAME=videonest
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD

MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=videonest
MINIO_REGION=us-east-1
MINIO_PUBLIC_ENDPOINT=http://82.157.205.6:9000
MINIO_API_CORS_ALLOW_ORIGIN=http://82.157.205.6
MINIO_PUBLIC_READ_PREFIXES=processed/,cover/processed/

# 至少 32 个随机字符；已经投入使用后不要随意更换，否则现有 JWT 会全部失效。
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
FLYWAY_BASELINE_VERSION=3

VIDEO_REVIEW_TIMEOUT_MILLISECONDS=86400000
RESOURCE_RETENTION_DAYS=7
VIDEO_PROCESS_CONSUMER_CONCURRENCY=2
VIDEO_VIEW_DEDUP_WINDOW_SECONDS=1800
ANONYMOUS_VIEW_LIMIT_PER_MINUTE=30
UPLOAD_SCAN_TIMEOUT_SECONDS=120
ANTIVIRUS_REQUIRED=false

VITE_PUBLIC_SITE_URL=http://82.157.205.6
HTTP_PORT=80

# 复用服务器上已经安装 FFmpeg 的后端镜像；部署脚本不会重新下载 FFmpeg。
BACKEND_RUNTIME_IMAGE=videonest-backend:latest
