{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\" index.html vite.config.ts tsconfig*.json package.json",
    "format:check": "prettier --check \"src/**/*.{vue,ts,css}\" index.html vite.config.ts tsconfig*.json package.json"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "element-plus": "^2.14.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "prettier": "3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5"
  }
}
